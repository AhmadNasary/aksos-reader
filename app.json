{
  "expo": {
    "name": "Aksos",
    "slug": "aksos-reader",
    "scheme": "aksos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "af.aksosbookstore.reader",
      "supportsTablet": true,
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIFileSharingEnabled": true
      }
    },
    "android": {
      "package": "af.aksosbookstore.reader",
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "15.1" },
          "android": { "compileSdkVersion": 35 }
        }
      ],
      "./plugins/withReadium.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
